MONGO_URI=

PORT=5000

FRONTEND_URL=http://localhost:5173/

AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

JWT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALLBACK_URL=

IDURA_BASE_URL=
IDURA_CLIENT_ID=
IDURA_CLIENT_SECRET=
IDURA_CALLBACK_URL=

STRIPE_SECRET_KEY=

# Stripe test mode keys (used when STRIPE_TEST_MODE is enabled in Superadmin Abonnementer page)
STRIPE_TEST_SECRET_KEY=

# REQUIRED for SafePay. Signing secret for the Stripe webhook that confirms payments.
# Endpoint: POST <API_URL>/api/safepay-checkout/webhook
# Events:   checkout.session.completed, checkout.session.expired
# Without this the webhook rejects every event and a payment whose browser redirect
# never came back is captured by Stripe but never recorded as paid.
STRIPE_WEBHOOK_SECRET=
# Optional: separate signing secret for the test-mode endpoint. Falls back to
# STRIPE_WEBHOOK_SECRET when unset.
STRIPE_TEST_WEBHOOK_SECRET=

VIPPS_BASE_URL=https://api.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUB_KEY=
VIPPS_REDIRECT_URI=


CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (SMTP) - for Forgot Password emails
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

NODE_ENV=development