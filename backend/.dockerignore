# Things Docker should NOT copy into the image (keeps builds fast & safe)

# Installed packages (the image runs its own npm install)
node_modules

# Secrets & local settings (never bake these into an image)
.env
.env.*

# Google/Firebase service-account keys. The Admin SDK reads one at RUNTIME from
# GOOGLE_APPLICATION_CREDENTIALS (a mounted secret file) — never from the image.
# The Dockerfile also refuses to build if a private key slips past this list.
*firebase-adminsdk*.json
**/*firebase-adminsdk*.json
*service-account*.json
**/*service-account*.json
*.pem
**/*.pem
*.p12
**/*.p12

# Test output and logs
coverage
*.log
test-results.log

# Build output (rebuilt inside the container)
dist

# Editor / OS junk
.vscode
.DS_Store
