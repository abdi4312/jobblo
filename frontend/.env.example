VITE_MAIN_URL=http://localhost:5000


VITE_GOOGLE_MAPS_API_KEY=

VITE_PUBLIC_SITE_URL=https://jobblo.no

# BankID / Idura is driven entirely server-side: the browser only navigates to
# GET /api/auth/idura. The former VITE_IDURA_DOMAIN / _ACR / _CLIENT_ID /
# _REDIRECT_URI are gone — a browser-built authorize URL was the original defect,
# and shipping the client id and ACR into the bundle served no purpose once the
# flow moved to the server. The backend equivalents live in backend/.env.example.
