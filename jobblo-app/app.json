{
  "expo": {
    "name": "Jobblo",
    "slug": "jobblo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "jobblo",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jobblo.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jobblo.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jobblo trenger tilgang til bildene dine slik at du kan legge til bilder av oppdraget, profilbilde og dokumentasjon av utført arbeid.",
          "cameraPermission": "Jobblo bruker kameraet slik at du kan ta bilder av oppdraget og dokumentere utført arbeid."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Jobblo bruker posisjonen din til å plassere oppdraget ditt på kartet og vise oppdrag i nærheten av deg."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
